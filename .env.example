# ════════════════════════════════════════════════════════════════════════
#  Krix: example environment
#  Copy to .env and fill in. Lines starting with "#" are optional/defaults.
#  Generate every secret independently with:  openssl rand -hex 32
# ════════════════════════════════════════════════════════════════════════

# ── Server ───────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
# Canonical public HTTPS origin (no trailing path, no credentials).
# REQUIRED in production: used for OAuth, file links and icons.
PUBLIC_BASE_URL=https://krix.example.com
# Number of reverse-proxy hops in front of the server (Render/Cloudflare = 1)
TRUST_PROXY=1
# Comma-separated browser origins allowed to call /mcp. Empty = no origin restriction.
# ALLOWED_ORIGINS=https://claude.ai,https://gemini.google.com
# Where keys, settings and local state are stored when not in MongoDB (default ./data)
# KRIX_DATA_DIR=./data

# ── Secrets (REQUIRED in production) ─────────────────────────────────────
# In production the server refuses to start unless ALL FOUR are >= 32 bytes,
# are not placeholders (change_me, example, replace_, your_), and are DIFFERENT
# from each other.
#
# Primary (owner) API key used by MCP clients as a Bearer token
MCP_API_KEY=change_me_generate_with_openssl_rand_hex_32
# Signs session cookies and tokens
SESSION_SECRET=change_me_generate_with_openssl_rand_hex_32
# HMAC pepper used to pseudonymize IPs in the security audit log
AUDIT_HASH_SECRET=change_me_generate_with_openssl_rand_hex_32
# AES-256-GCM key that encrypts per-key GitHub/Render credentials at rest
KEY_ENCRYPTION_SECRET=change_me_generate_with_openssl_rand_hex_32

# ── Google sign-in (dashboard) ───────────────────────────────────────────
# The owner account: full limits and workspace-wide settings
OWNER_EMAIL=you@example.com
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Comma-separated extra emails allowed to sign in (in addition to the owner)
# ALLOWED_EMAILS=friend@example.com,teammate@example.com
# Set to false to block everyone except the owner/allowed emails
# MULTI_USER=true

# Google reCAPTCHA v3 site key loaded on the web pages (optional; a sample key is used if unset)
# RECAPTCHA_SITE_KEY=

# ── OAuth 2.1 for MCP clients (optional) ─────────────────────────────────
# Without these, signing keys are generated at startup and tokens stop working
# after a restart. Provide PEM strings (use \n for newlines).
# RSA_PRIVATE_KEY=
# RSA_PUBLIC_KEY=
# Logo shown on the OAuth consent screen (https URL). Defaults to the Krix logo.
# KRIX_OAUTH_LOGO_URI=https://krix.example.com/icon-128.png

# ── Database (REQUIRED in production) ────────────────────────────────────
# Stores users, keys, OAuth state, stats, the audit log and the file store.
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/
MONGODB_DB=krix

# ── Provider credentials (global defaults for the primary key) ───────────
# Other API keys and OAuth clients can use their own credentials in the dashboard.
# GitHub tools stay OFF without a GitHub token; Render tools stay OFF without a Render key.
GITHUB_PERSONAL_ACCESS_TOKEN=
RENDER_API_KEY=

# ── Email notifications (optional) ───────────────────────────────────────
# Sent on: account creation, account deletion request & final deletion, sign-in
# from a new IP, OAuth client authorization, first API key milestone, API key
# deletion, welcome back (7+ days away), and 14-day inactivity check-ins.
# If nothing below is set, emails are skipped.
#
# Option A: Gmail API over HTTPS (recommended on Render/Railway/free tiers that
# block SMTP ports 25/465/587). OAuth scope needed: gmail.send
GMAIL_USER=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
#
# Option B: SMTP via Nodemailer (self-hosted, VPS, SES, Mailgun, ...)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
# Or a single connection URL instead of the fields above:
# SMTP_URL=smtps://user:pass@smtp.example.com:465
EMAIL_FROM="Krix" <no-reply@krix.example.com>

# ── Browser Web Push notifications (optional) ────────────────────────────
# Delivers background browser/mobile notifications via /sw.js even when tabs
# are closed. Generate once with:  npx web-push generate-vapid-keys
# Without these, ephemeral keys are generated on startup (lost on redeploy).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact email (mailto:you@example.com) or site URL (https://krix.example.com).
# Optional: defaults to mailto:<OWNER_EMAIL> or PUBLIC_BASE_URL.
# VAPID_SUBJECT=mailto:you@example.com

# ── Tool availability (deployment-level switches) ────────────────────────
# Which tools each user/key gets (Render, extended GitHub, code graph, ...) is
# controlled in the dashboard under Settings. Environment flags do NOT enable
# those categories. Only these two kill switches exist at deployment level:
#
# Sandbox: must be "true" to run code. Needs the Docker image (root + unprivileged
# sandbox user) so users are isolated. Set false to forbid sandbox tools entirely.
ENABLE_SANDBOX=true
# Sandbox Store and web-upload file tools
ENABLE_FILE_SHARING=true

# ── Sandbox isolation (set automatically by the Dockerfile) ──────────────
# SANDBOX_UID=10001
# SANDBOX_GID=10001
# Refuse to run code if isolation cannot be established
# SANDBOX_REQUIRE_ISOLATION=true
# Give every user their own uid (false = everyone shares SANDBOX_UID)
# SANDBOX_PER_USER_UID=true
# SANDBOX_UID_BASE=20000
# SANDBOX_UID_RANGE=40000
# Storage cap for the owner's sandbox, in MB (other users get 50 MB)
SANDBOX_MAX_TOTAL_MB=300
# Release an idle cloned repo after this many minutes (1-1440)
REPO_IDLE_MINUTES=30
# Unisolated, owner-only sandbox on Render WITHOUT Docker (NOT recommended):
# SANDBOX_RENDER_OWNER_ONLY_ACK=true  (also needs SANDBOX_REQUIRE_ISOLATION=false)

# ── Sandbox Store (file sharing) ─────────────────────────────────────────
# Hours before a shared file expires (unless made permanent)
FILE_TTL_HOURS=72
# Max size of one shared file, MB
FILE_MAX_MB=25
# Max shared files per owner
FILE_MAX_PER_OWNER=50
# Max total shared storage per owner, MB
FILE_MAX_TOTAL_MB_PER_OWNER=200
# Max size of a file fetched by sandbox_store "download", MB
DOWNLOAD_MAX_MB=50
# Allow downloads from private/internal addresses (SSRF risk, keep false)
# ALLOW_PRIVATE_DOWNLOADS=false

# ── Web upload page (/upload) ────────────────────────────────────────────
ENABLE_WEB_UPLOAD=true
# How long an upload session stays open, minutes
UPLOAD_SESSION_MINUTES=10
# How long uploaded files stay in the sandbox after the session, minutes
# UPLOAD_FILE_RETENTION_MINUTES=60
# Concurrent upload sessions
# UPLOAD_MAX_SESSIONS=5
UPLOAD_MAX_FILE_MB=25
UPLOAD_MAX_FILES=20
UPLOAD_MAX_TOTAL_MB=100

# ── Hardening ────────────────────────────────────────────────────────────
# Best-effort guards on sandbox commands / network targets: low | medium | high
# (guardrails, not a firewall; also enforce egress rules at the container level)
COMMAND_RESTRICTION_LEVEL=low
NETWORK_RESTRICTION_LEVEL=low
# Accept ?api_key=... in the URL (leaks into logs and history, keep false)
ALLOW_QUERY_API_KEY=false
# Requests per minute per client
RATE_LIMIT_PER_MIN=600
# Max concurrent MCP sessions
MAX_SESSIONS=50
# Max request body, MB
MAX_BODY_MB=16
# How long cached auth context is kept, ms (default 1 hour)
AUTH_CONTEXT_TTL_MS=3600000

# ── Legacy aliases (still read; prefer the names above) ──────────────────
# GITHUB_PAT -> GITHUB_PERSONAL_ACCESS_TOKEN     RENDER_PAT -> RENDER_API_KEY
# MONGO_URL / DATABASE_URL -> MONGODB_URI        MONGODB_DB_NAME -> MONGODB_DB
# GOOGLE_ALLOWED_EMAIL -> OWNER_EMAIL            SMTP_FROM -> EMAIL_FROM
# AUTH_SECRET -> signing secret fallback         GOOGLE_RECAPTCHA_SITE_KEY -> RECAPTCHA_SITE_KEY
# Set automatically by the platform (do not set): RENDER, RENDER_SERVICE_ID
