# Krix — local environment. Fill in the values, never commit this file.

# ── Server ───────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
# Public https URL of this server (file links, OAuth, icons). Strongly recommended.
PUBLIC_BASE_URL=https://krix.example.com
# Reverse-proxy hops in front of the server
TRUST_PROXY=1

# ── Auth (REQUIRED) ──────────────────────────────────────────────────────
# Gateway key; the server refuses to start without it. Generate: openssl rand -hex 32
MCP_API_KEY=change_me_generate_with_openssl_rand_hex_32
# Signs session cookies and OAuth JWTs (falls back to MCP_API_KEY)
SESSION_SECRET=change_me_long_random_secret
# 32+ bytes. REQUIRED to save per-key GitHub/Render credentials (encrypts them at rest)
KEY_ENCRYPTION_SECRET=change_me_at_least_32_bytes_long_secret_value

# ── Google sign-in (owner only) ──────────────────────────────────────────
OWNER_EMAIL=you@example.com
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# ── Provider credentials (global defaults for the primary key) ───────────
# Other API keys / OAuth clients use their own override (API Keys → Info).
# Without a GitHub token, GitHub tools cannot be enabled; without a Render key, Render tools cannot.
GITHUB_PERSONAL_ACCESS_TOKEN=
RENDER_API_KEY=

# ── MongoDB (stats, OAuth state, file store) ─────────────────────────────
MONGODB_URI=
MONGODB_DB=krix

# ── Tools ────────────────────────────────────────────────────────────────
# Default GitHub tools (17) are always on once a token exists. These flags add MORE:
ENABLE_GITHUB_ISSUES_PRS=false
ENABLE_GITHUB_ADMIN=false
ENABLE_RENDER=false
ENABLE_ALL_TOOLS=false
ENABLE_SANDBOX=true
ENABLE_FILE_SHARING=true

# ── Files / uploads ──────────────────────────────────────────────────────
FILE_TTL_HOURS=72
FILE_MAX_MB=25
FILE_MAX_PER_OWNER=50
FILE_MAX_TOTAL_MB_PER_OWNER=200
DOWNLOAD_MAX_MB=50
ENABLE_WEB_UPLOAD=true
UPLOAD_SESSION_MINUTES=10
UPLOAD_MAX_FILE_MB=25
UPLOAD_MAX_FILES=20
UPLOAD_MAX_TOTAL_MB=100

# ── Hardening ────────────────────────────────────────────────────────────
COMMAND_RESTRICTION_LEVEL=low
NETWORK_RESTRICTION_LEVEL=low
ALLOW_QUERY_API_KEY=false
RATE_LIMIT_PER_MIN=600
MAX_SESSIONS=50
MAX_BODY_MB=16
AUTH_CONTEXT_TTL_MS=3600000
